# your game in progress: it changes every turn (start one with /newgame)
state/save.json
# the other games' saves, parked while you play another, and which game is active
state/shelf/
state/active.json
# the meter: what's left to spend this session
state/meter.json
# each game's library: what lasts across its runs (the owner manages it with tools/library.py)
state/library/
state/*.tmp
# world-agent proposals waiting to be applied; the script deletes them
proposals/*.json
# generated or local
__pycache__/
*.pyc
.DS_Store
